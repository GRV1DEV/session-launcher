{
  "manifest_version": 3,
  "name": "Session Launcher",
  "version": "0.1",
  "description": "Launch and manage browser sessions quickly.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Session Launcher"
  },
  "permissions": [
    "tabs",
    "storage",
    "sessions"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
